*.sls

# Generated directories and caches
_minted-*/
pythontex-files-*/
latex.out/
build/
__pycache__/
*.py[cod]
.venv/
venv/
.qa_deps/

# Local review, backup and audit material
backup/
qa/
source_audit/
textbook_audit_*/
final_delivery_*/
*audit*/
*backup*/

# Locally compiled books and release staging files
/book/main.pdf
/book_linear/main.pdf
/book_probability/main.pdf
/release/

