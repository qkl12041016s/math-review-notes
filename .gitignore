# This workspace contains unrelated local projects. Only the three books and
# release documentation are eligible for this repository.
/*
!/.gitignore
!/README.md
!/LICENSE
!/zhihu_publish.md
!/docs/
!/book/
!/book_linear/
!/book_probability/

# Public source allowlist inside each volume. This keeps local maintenance
# scripts, reports and alternate editions out of the repository.
/book/*
!/book/main.tex
!/book/preamble.tex
!/book/appendix/
!/book/assets/
!/book/chapters/
!/book/frontmatter/
/book/appendix/indefinite_answers.tex
/book/frontmatter/indefinite_cover.tex

/book_linear/*
!/book_linear/main.tex
!/book_linear/preamble.tex
!/book_linear/appendix/
!/book_linear/assets/
!/book_linear/bib/
!/book_linear/chapters/
!/book_linear/derivations/
!/book_linear/enrichment/
!/book_linear/frontmatter/

/book_probability/*
!/book_probability/main.tex
!/book_probability/preamble.tex
!/book_probability/appendix/
!/book_probability/assets/
!/book_probability/bib/
!/book_probability/chapters/
!/book_probability/frontmatter/

